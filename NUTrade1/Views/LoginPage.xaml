<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Title="Sign in">

    <Grid>
    <ScrollView>
        <Grid Padding="26" RowDefinitions="Auto,*,Auto,*">

            <HorizontalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Start">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackToWelcomeCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Path Style="{StaticResource LineChevronLeft}" HeightRequest="18" WidthRequest="18"
                      Stroke="{StaticResource InkMuted}" VerticalOptions="Center" />
                <Label Text="Back" FontFamily="InterRegular" FontSize="15" TextColor="{StaticResource InkMuted}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="18" VerticalOptions="Center">

                <Border HeightRequest="72" WidthRequest="72" StrokeThickness="1" Stroke="#D6DCE6" StrokeShape="RoundRectangle 999"
                        BackgroundColor="{StaticResource White}" HorizontalOptions="Center">
                    <Image Source="nutrade_mark.png" HeightRequest="46" WidthRequest="46" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="NU" FontFamily="InterSemiBold" FontSize="30"
                                      TextColor="{AppThemeBinding Light={StaticResource NuNavy}, Dark={StaticResource InkDark}}" />
                                <Span Text="Trade" FontFamily="InterSemiBold" FontSize="30" TextColor="{StaticResource NuGold}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Trade what you have for what you need — with verified National University–Lipa students."
                           Style="{StaticResource ScreenSubtitle}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="14">
                        <Border Style="{StaticResource InputShell}">
                            <Entry Style="{StaticResource ShellEntry}" Placeholder="Your email address" Text="{Binding Email}"
                               Keyboard="Email" ReturnType="Next" />
                        </Border>
                        <controls:PasswordField Placeholder="Password" Text="{Binding Password}"
                                                ReturnType="Go" ReturnCommand="{Binding SignInCommand}" />
                        <Label Text="Forgot password?" FontFamily="InterSemiBold" FontSize="13"
                               TextColor="{StaticResource NuNavy}" HorizontalOptions="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Text="Sign in" Style="{StaticResource GoldButton}"
                                Command="{Binding SignInCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <Button Text="New here? Create an account" Style="{StaticResource GhostButton}"
                                Command="{Binding CreateAccountCommand}" IsEnabled="{Binding IsNotBusy}" />

                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" IsVisible="{Binding IsGoogleSignInAvailable}">
                            <BoxView Grid.Column="0" HeightRequest="1" VerticalOptions="Center"
                                     Color="{StaticResource CardBorder}" />
                            <Label Grid.Column="1" Text="or" Style="{StaticResource MetaText}" VerticalOptions="Center" />
                            <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center"
                                     Color="{StaticResource CardBorder}" />
                        </Grid>

                        <Button Text="Continue with Google" Style="{StaticResource GhostButton}"
                                IsVisible="{Binding IsGoogleSignInAvailable}"
                                Command="{Binding SignInWithGoogleCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <controls:LoadingDots IsRunning="{Binding IsBusy}" />
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Path Style="{StaticResource IconVerified}" HeightRequest="13" WidthRequest="13"
                                  Fill="{StaticResource InkMuted}" />
                            <Label Text="Any email works. We send a code to confirm it." Style="{StaticResource MetaText}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

        <controls:ToastHost />
    </Grid>

</views:AppContentPage>
