<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    xmlns:core="clr-namespace:NUTrade1.Core;assembly=NUTrade1.Core"
    x:Name="Page"
    x:DataType="vm:ProfileViewModel"
    Title="Profile">

    <Grid RowDefinitions="Auto,*">

        <controls:TopBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <Grid>

            <!-- First visit: the profile in bones — identity card, stats, wallet, listings. -->
            <controls:Skeleton IsActive="{Binding IsLoading}">
                <VerticalStackLayout Padding="20,10,20,120" Spacing="14">
                    <Border Style="{StaticResource HeroCard}" Padding="20,18">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" Style="{StaticResource BoneOnDark}" HeightRequest="46" WidthRequest="46" StrokeShape="RoundRectangle 999" />
                                <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                    <Border Style="{StaticResource BoneOnDark}" HeightRequest="15" WidthRequest="130" />
                                    <Border Style="{StaticResource BoneOnDark}" HeightRequest="10" WidthRequest="90" />
                                    <Border Style="{StaticResource BoneOnDark}" HeightRequest="9" WidthRequest="160" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border Style="{StaticResource BoneOnDark}" HeightRequest="22" WidthRequest="170" StrokeShape="RoundRectangle 999" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="8,14">
                            <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                                <Border Style="{StaticResource BoneRound}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" />
                                <Border Style="{StaticResource Bone}" HeightRequest="15" WidthRequest="34" HorizontalOptions="Center" />
                                <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="50" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatCard}" Padding="8,14">
                            <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                                <Border Style="{StaticResource BoneRound}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" />
                                <Border Style="{StaticResource Bone}" HeightRequest="15" WidthRequest="34" HorizontalOptions="Center" />
                                <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="50" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="8,14">
                            <VerticalStackLayout Spacing="7" HorizontalOptions="Center">
                                <Border Style="{StaticResource BoneRound}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" />
                                <Border Style="{StaticResource Bone}" HeightRequest="15" WidthRequest="34" HorizontalOptions="Center" />
                                <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="50" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource BoneRound}" HeightRequest="40" WidthRequest="40" />
                            <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                <Border Style="{StaticResource Bone}" HeightRequest="13" WidthRequest="70" />
                                <Border Style="{StaticResource Bone}" HeightRequest="10" WidthRequest="120" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Bone}" HeightRequest="14" WidthRequest="96" Margin="0,4,0,0" />
                    <Border Style="{StaticResource Card}" Padding="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource Bone}" HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 12" />
                            <VerticalStackLayout Grid.Column="1" Spacing="8" Padding="0,6">
                                <Border Style="{StaticResource Bone}" HeightRequest="13" WidthRequest="150" />
                                <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="110" />
                                <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="70" Margin="0,14,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource Bone}" HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 12" />
                            <VerticalStackLayout Grid.Column="1" Spacing="8" Padding="0,6">
                                <Border Style="{StaticResource Bone}" HeightRequest="13" WidthRequest="130" />
                                <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="100" />
                                <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="70" Margin="0,14,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </controls:Skeleton>

            <VerticalStackLayout Padding="20,10,20,120" Spacing="14" IsVisible="{Binding IsNotLoading}">

                <!-- Identity card -->
                <Border Style="{StaticResource HeroCard}" Padding="20,18">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" HeightRequest="46" WidthRequest="46" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource NuGold}" VerticalOptions="Center">
                                <Label Text="{Binding Profile.DisplayName, Converter={StaticResource Initials}}"
                                       FontFamily="InterBold" FontSize="15" TextColor="{StaticResource NuNavy}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding Profile.DisplayName, FallbackValue='Your name', TargetNullValue='Your name'}"
                                       FontFamily="InterBold" FontSize="17" TextColor="{StaticResource White}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Profile, Converter={StaticResource HubProgram}}"
                                           FontFamily="InterRegular" FontSize="12.5" TextColor="#C4CCE6" />
                                    <Label Text="{Binding ProgramActionText}"
                                           FontFamily="InterSemiBold" FontSize="12.5" TextColor="{StaticResource NuGold}" />
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChooseProgramCommand}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Profile.Email, FallbackValue='', TargetNullValue=''}"
                                       FontFamily="InterRegular" FontSize="11.5" TextColor="{StaticResource HeroMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border BackgroundColor="{StaticResource HeroPill}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                Padding="14,4" HorizontalOptions="Start" IsVisible="{Binding IsVerified}">
                            <Label Text="Verified NU–Lipa student" FontFamily="InterMedium" FontSize="10.5"
                                   TextColor="{StaticResource NuGold}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Stats -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="8,14">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Path Style="{StaticResource LineStar}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center"
                                  Stroke="{StaticResource NuNavy}" StrokeThickness="1.6" />
                            <Label Text="{Binding RatingText}" FontFamily="InterBold" FontSize="17"
                                   HorizontalOptions="Center" TextColor="{StaticResource Ink}" />
                            <Label Text="Rating" FontFamily="InterRegular" FontSize="11" TextColor="#A1A6B1" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCard}" Padding="8,14">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Path Style="{StaticResource NavStore}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center"
                                  Stroke="{StaticResource NuNavy}" StrokeThickness="1.6" />
                            <Label Text="{Binding BidsReceivedCount}" FontFamily="InterBold" FontSize="17"
                                   HorizontalOptions="Center" TextColor="{StaticResource Ink}" />
                            <Label Text="Bids received" FontFamily="InterRegular" FontSize="11" TextColor="#A1A6B1" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="8,14">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <!-- Spacer lining the number up with the other two cards. A transparent BoxView drew
                                 as a solid black square on some Android phones. -->
                            <ContentView HeightRequest="20" />
                            <Label Text="{Binding ActiveCount}" FontFamily="InterBold" FontSize="17"
                                   HorizontalOptions="Center" TextColor="{StaticResource Ink}" />
                            <Label Text="Active" FontFamily="InterRegular" FontSize="11" TextColor="#A1A6B1" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Bid credit: spent on the next deposit, never cashed out -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" StrokeThickness="0" VerticalOptions="Center"
                                StrokeShape="RoundRectangle 999" Background="{StaticResource HeroBrush}">
                            <Path Style="{StaticResource IconTag}" HeightRequest="18" WidthRequest="18"
                                  HorizontalOptions="Center" VerticalOptions="Center" Fill="{StaticResource NuGold}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Bid credit" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Ink}" />
                            <Label Text="{Binding WalletBalanceDisplay, StringFormat='{0} for your next deposit'}" Style="{StaticResource MetaText}" />
                        </VerticalStackLayout>
                        <Path Grid.Column="2" Style="{StaticResource IconChevronRight}" HeightRequest="20" WidthRequest="20"
                              VerticalOptions="Center" Fill="{StaticResource InkMuted}" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenWalletCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Admin only: the listing approval queue -->
                <Border Style="{StaticResource Card}" Padding="14" IsVisible="{Binding IsAdmin}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" StrokeThickness="0" VerticalOptions="Center"
                                StrokeShape="RoundRectangle 999" Background="{StaticResource HeroBrush}">
                            <Path Style="{StaticResource LineCheck}" HeightRequest="18" WidthRequest="18"
                                  HorizontalOptions="Center" VerticalOptions="Center" Stroke="{StaticResource NuGold}" StrokeThickness="2.4" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Listing approvals" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Ink}" />
                            <Label Text="{Binding PendingApprovalCount, StringFormat='{0} waiting for review'}" Style="{StaticResource MetaText}" />
                        </VerticalStackLayout>
                        <Path Grid.Column="2" Style="{StaticResource IconChevronRight}" HeightRequest="20" WidthRequest="20"
                              VerticalOptions="Center" Fill="{StaticResource InkMuted}" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenApprovalsCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- My listings -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="My listings" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource Ink}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="{StaticResource NuGold}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                            Padding="14,3" VerticalOptions="Center">
                        <Label Text="New" FontFamily="InterBold" FontSize="11.5" TextColor="{StaticResource NuNavy}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NewListingCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasListings}" BindableLayout.ItemsSource="{Binding MyListings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="core:Listing">
                            <Border Style="{StaticResource Card}" Padding="8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenListingCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" HeightRequest="80" WidthRequest="80" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12" BackgroundColor="#A5B1C8">
                                        <Image Aspect="AspectFill" Source="{Binding Photos, Converter={StaticResource FirstOrDefault}}" />
                                    </Border>
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Padding="0,4">
                                        <Label Grid.Row="0" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Ink}"
                                               MaxLines="1" LineBreakMode="TailTruncation" Text="{Binding Title}" />
                                        <HorizontalStackLayout Grid.Row="1" Spacing="6">
                                            <Label Text="Priority Listing" FontFamily="InterRegular" FontSize="11" TextColor="#9BA0AC"
                                                   IsVisible="{Binding IsPinned}" />
                                            <Label FontFamily="InterRegular" FontSize="11" TextColor="#9BA0AC"
                                                   Text="{Binding CurrentHighestBidCentavos, Converter={StaticResource Centavos}, StringFormat='{0} current bid'}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="3" FontSize="11" FontFamily="InterMedium"
                                               TextColor="{Binding Status, Converter={StaticResource ListingStatusColor}}"
                                               Text="{Binding Status, Converter={StaticResource ListingStatusText}}" />
                                        <Label Grid.Row="2" Style="{StaticResource MetaText}" FontSize="11" VerticalOptions="End"
                                               Text="{Binding RejectionReason}"
                                               IsVisible="{Binding RejectionReason, Converter={StaticResource HasValue}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasListings, Converter={StaticResource InvertBool}}">
                    <VerticalStackLayout Spacing="6" Padding="0,10">
                        <Label Text="No listings yet" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                        <Label Text="Post an item to start auctioning it off to campus." Style="{StaticResource ScreenSubtitle}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Incoming bids -->
                <VerticalStackLayout Spacing="1" IsVisible="{Binding HasIncomingBids}" Margin="0,4,0,0">
                    <Label Text="Incoming bids" FontFamily="InterBold" FontSize="15" TextColor="{StaticResource Ink}" />
                    <Label Text="Approve one bid to confirm the buyer and start a chat." FontFamily="InterRegular" FontSize="11"
                           TextColor="{StaticResource InkMuted}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasIncomingBids}" BindableLayout.ItemsSource="{Binding IncomingBids}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:IncomingBidViewModel">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" HeightRequest="38" WidthRequest="38" StrokeThickness="0" VerticalOptions="Center"
                                            StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource NuGold}" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label FontFamily="InterBold" FontSize="14" TextColor="{StaticResource Ink}" Text="{Binding BidderName}" />
                                        <Label FontFamily="InterRegular" FontSize="10.5" TextColor="{StaticResource InkMuted}"
                                               MaxLines="1" LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding ListingTitle}" />
                                                    <Span Text=" • " />
                                                    <Span Text="{Binding CreatedAt, Converter={StaticResource TimeAgo}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontFamily="InterBold" FontSize="15" TextColor="{StaticResource Ink}" Text="{Binding AmountDisplay}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                        <Border BackgroundColor="{StaticResource DeclineBg}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                                Padding="14,4" WidthRequest="72">
                                            <Label Text="Decline" FontFamily="InterSemiBold" FontSize="10.5" TextColor="{StaticResource DeclineText}"
                                                   HorizontalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeclineCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                        <Border BackgroundColor="{StaticResource ApproveBg}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                                Padding="14,4" WidthRequest="72">
                                            <Label Text="Approve" FontFamily="InterSemiBold" FontSize="10.5" TextColor="{StaticResource ApproveText}"
                                                   HorizontalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.ApproveCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>


                <Button Text="Sign out" Style="{StaticResource GhostButton}" Command="{Binding SignOutCommand}" Margin="0,6,0,0" />

            </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1" Active="Profile" VerticalOptions="End" />

        <!-- In-app notifications (posted, won, paid) draw over the page -->
        <controls:NotificationHost Grid.Row="0" Grid.RowSpan="2" />
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="2" />
    </Grid>

</views:AppContentPage>
