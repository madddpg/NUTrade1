<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.PostTradePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    x:Name="Page"
    x:DataType="vm:PostTradeViewModel"
    Title="Create an auction">

    <Grid RowDefinitions="Auto,*">

        <controls:TopBar Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,120" Spacing="12">

                <Label Text="Create an auction" Style="{StaticResource ScreenTitle}" FontSize="20" />

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="12">

                        <!-- Photos: the whole picture, never cropped, once any are added -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasPhotos}">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="180"
                                    BackgroundColor="{StaticResource PageTop}">
                                <CarouselView ItemsSource="{Binding PhotoPaths}" IndicatorView="{x:Reference PhotoIndicator}"
                                              Loop="False" PeekAreaInsets="0">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid>
                                                <Image Source="{Binding .}" Aspect="AspectFit" />
                                                <Border BackgroundColor="{StaticResource OverlayDark}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                                        HeightRequest="26" WidthRequest="26" Margin="10" HorizontalOptions="End" VerticalOptions="Start">
                                                    <Path Style="{StaticResource LineClose}" HeightRequest="12" WidthRequest="12"
                                                          Stroke="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemovePhotoCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>
                            </Border>
                            <IndicatorView x:Name="PhotoIndicator" HorizontalOptions="Center"
                                           IndicatorSize="6" IndicatorColor="{StaticResource ChipBorder}"
                                           SelectedIndicatorColor="{StaticResource NuGold}" />
                        </VerticalStackLayout>

                        <Border StrokeShape="RoundRectangle 14" StrokeThickness="1.2" StrokeDashArray="4,3"
                                Stroke="#B9C2D2" BackgroundColor="{StaticResource CardBg}" HeightRequest="112"
                                IsVisible="{Binding CanAddPhoto}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Path Style="{StaticResource LineImagePlus}" HeightRequest="26" WidthRequest="26"
                                      Stroke="{StaticResource InkMuted}" HorizontalOptions="Center" />
                                <Label Text="Add up to 4 photos" FontFamily="InterSemiBold" FontSize="14"
                                       TextColor="{StaticResource NuNavy}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddPhotoCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Item name -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Item name" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputShell}">
                                <Entry Style="{StaticResource ShellEntry}" Text="{Binding ItemTitle}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Description" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputShell}" Padding="12,4">
                                <Editor Style="{StaticResource ShellEditor}" Text="{Binding Description}" MinimumHeightRequest="42" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Category / Condition -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Category *" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Picker Grid.Column="0" Style="{StaticResource ShellPicker}" Title="Select a category"
                                                ItemsSource="{Binding CategoryOptions}" ItemDisplayBinding="{Binding Label}"
                                                SelectedItem="{Binding SelectedCategoryOption}" />
                                        <Path Grid.Column="1" Style="{StaticResource IconChevronDown}" HeightRequest="14" WidthRequest="14"
                                              Fill="{StaticResource InkMuted}" VerticalOptions="Center" InputTransparent="True"
                                              IsVisible="{OnPlatform Default=True, WinUI=False}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Condition" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Picker Grid.Column="0" Style="{StaticResource ShellPicker}"
                                                ItemsSource="{Binding ConditionOptions}" ItemDisplayBinding="{Binding Label}"
                                                SelectedItem="{Binding SelectedConditionOption}" />
                                        <Path Grid.Column="1" Style="{StaticResource IconChevronDown}" HeightRequest="14" WidthRequest="14"
                                              Fill="{StaticResource InkMuted}" VerticalOptions="Center" InputTransparent="True"
                                              IsVisible="{OnPlatform Default=True, WinUI=False}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- "Other" is not an answer on its own, so ask for one. -->
                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsCategoryOther}">
                            <Label Text="Which category?" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputShell}">
                                <Entry Style="{StaticResource ShellEntry}" Text="{Binding CategoryOther}"
                                       Placeholder="e.g. Lab equipment, PE gear" MaxLength="40" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Starting bid / increment -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Starting bid" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Entry Style="{StaticResource ShellEntry}" Keyboard="Numeric" Text="{Binding StartingBidText}" Placeholder="₱" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Bid increment" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Entry Style="{StaticResource ShellEntry}" Keyboard="Numeric" Text="{Binding BidIncrementText}" Placeholder="₱" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Meetup location -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Meetup location *" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputShell}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Picker Grid.Column="0" Style="{StaticResource ShellPicker}" Title="Select a location"
                                            ItemsSource="{Binding ZoneOptions}" ItemDisplayBinding="{Binding Label}"
                                            SelectedItem="{Binding SelectedZoneOption}" />
                                    <Path Grid.Column="1" Style="{StaticResource IconChevronDown}" HeightRequest="14" WidthRequest="14"
                                          Fill="{StaticResource InkMuted}" VerticalOptions="Center" InputTransparent="True"
                                          IsVisible="{OnPlatform Default=True, WinUI=False}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsMeetupOther}">
                            <Label Text="Where exactly?" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputShell}">
                                <Entry Style="{StaticResource ShellEntry}" Text="{Binding CampusZoneOther}"
                                       Placeholder="e.g. Canteen, 3rd floor lobby" MaxLength="60" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,4" />

                        <!-- Package. Free is a student's first listing only, so it disappears once used. -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="CHOOSE A PACKAGE" FontFamily="InterBold" FontSize="11" CharacterSpacing="0.8"
                                   TextColor="{StaticResource NuGold}" />
                            <Label Text="You've used your free first post, so each new listing has a posting fee."
                                   Style="{StaticResource MetaText}" IsVisible="{Binding ShowFreeUsedNote}" />

                            <controls:PackageOption Title="Free" Subtitle="First auction" Price="₱ 0" Value="Free"
                                                    IsVisible="{Binding IsFreeAvailable}"
                                                    Command="{Binding SelectPackageCommand}"
                                                    IsSelected="{Binding SelectedPackage, Converter={StaticResource EnumEquals}, ConverterParameter=Free}" />
                            <controls:PackageOption Title="Additional" Subtitle="Additional auction" Price="₱ 10" Value="Additional"
                                                    Command="{Binding SelectPackageCommand}"
                                                    IsSelected="{Binding SelectedPackage, Converter={StaticResource EnumEquals}, ConverterParameter=Additional}" />
                            <controls:PackageOption Title="Priority" Subtitle="Pin to top of feed" Price="₱ 20" Value="Priority"
                                                    Command="{Binding SelectPackageCommand}"
                                                    IsSelected="{Binding SelectedPackage, Converter={StaticResource EnumEquals}, ConverterParameter=Priority}" />
                        </VerticalStackLayout>


                        <Button Text="Continue to review ›" Style="{StaticResource GoldButton}" FontSize="13.5"
                                Command="{Binding ContinueToReviewCommand}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="1" Active="Post" VerticalOptions="End" />

        <!-- In-app notifications (posted, won, paid) draw over the page -->
        <controls:NotificationHost Grid.Row="0" Grid.RowSpan="2" />
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="2" />
    </Grid>

</views:AppContentPage>
