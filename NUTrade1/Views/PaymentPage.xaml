<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.PaymentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    x:DataType="vm:PaymentViewModel"
    Title="Pay listing fee">

    <Grid RowDefinitions="Auto,*">

        <controls:DetailBar Grid.Row="0" HeaderTitle="Pay listing fee" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,6,20,28" Spacing="18">

                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding Kicker}" Style="{StaticResource Kicker}" />
                    <Label Text="{Binding Heading}" Style="{StaticResource ScreenTitle}" FontSize="23" />
                    <Label Text="{Binding Subheading}" Style="{StaticResource ScreenSubtitle}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="20" IsVisible="{Binding ShowQr}">
                    <VerticalStackLayout Spacing="14">
                        <controls:PaymentQrView ImageUrl="{Binding Qr.QrImageUrl}" ImageBase64="{Binding Qr.QrImageBase64}"
                                                FileName="{Binding QrFileName}" IsLoading="{Binding IsBusy}" />

                        <Label Text="{Binding AmountDisplay}" FontFamily="InterSemiBold" FontSize="26"
                               TextColor="{StaticResource Ink}" HorizontalOptions="Center" />
                        <Label Text="{Binding PackageName, StringFormat='{0} listing'}" Style="{StaticResource MetaText}"
                               HorizontalOptions="Center" />

                        <Button Text="I've paid — check now" Style="{StaticResource NavyButton}"
                                Command="{Binding CheckNowCommand}" IsVisible="{Binding HasQrImage}" />
                        <Label Text="{Binding PaymentCheckMessage}" Style="{StaticResource MetaText}" HorizontalTextAlignment="Center"
                               IsVisible="{Binding PaymentCheckMessage, Converter={StaticResource HasValue}}" />
                        <Button Text="Generate a new code" Style="{StaticResource GhostButton}"
                                Command="{Binding GenerateCommand}" IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Paid (or free): sitting in the admin queue. -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsAwaitingApproval}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" HeightRequest="38" WidthRequest="38" StrokeThickness="0" VerticalOptions="Center"
                                StrokeShape="RoundRectangle 999"
                                BackgroundColor="{AppThemeBinding Light={StaticResource GoldSoft}, Dark={StaticResource GoldSoftDark}}">
                            <Path Style="{StaticResource IconClock}" HeightRequest="19" WidthRequest="19"
                                  HorizontalOptions="Center" VerticalOptions="Center" Fill="{StaticResource NuGold}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Pending admin approval" Style="{StaticResource CardTitle}" FontSize="14" />
                            <Label Text="You can leave this screen — its status shows under My listings on your profile."
                                   Style="{StaticResource MetaText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsApproved}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource GoldSoft}, Dark={StaticResource GoldSoftDark}}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Grid.Column="0" Style="{StaticResource IconCheck}" HeightRequest="20" WidthRequest="20"
                              Fill="{StaticResource GoldSoftText}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ApprovedText}" Style="{StaticResource CardTitle}" FontSize="13.5"
                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsRejected}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Grid.Column="0" Style="{StaticResource IconClose}" HeightRequest="20" WidthRequest="20" VerticalOptions="Center"
                              Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        <Label Grid.Column="1" Text="{Binding RejectedText}" Style="{StaticResource CardTitle}" FontSize="13.5"
                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>


                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsSubmitted}">
                    <Button Text="Go to the feed" Style="{StaticResource GoldButton}" Command="{Binding DoneCommand}" />
                    <Button Text="View my listings" Style="{StaticResource GhostButton}" Command="{Binding ViewMyListingsCommand}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding ShowQr}">
                    <Path Grid.Column="0" Style="{StaticResource IconClock}" HeightRequest="13" WidthRequest="13"
                          Fill="{StaticResource InkMuted}" VerticalOptions="Start" Margin="0,2,0,0" />
                    <Label Grid.Column="1" Text="{Binding ExpiryText}" Style="{StaticResource MetaText}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Last child, spanning both rows, so it draws over the header and content. -->
        <controls:NotificationHost Grid.Row="0" Grid.RowSpan="2" />
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="2" />
    </Grid>

</views:AppContentPage>
