<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.ListingApprovalsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    x:Name="Page"
    x:DataType="vm:ListingApprovalsViewModel"
    Title="Listing approvals">

    <ContentPage.Resources>
        <!-- One queued listing in bones: cover, title, seller, package badge, description,
             starting bid and time, Reject / Approve. -->
        <ControlTemplate x:Key="ApprovalCardBones">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Style="{StaticResource Bone}" HeightRequest="72" WidthRequest="72" StrokeShape="RoundRectangle 14" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Border Style="{StaticResource Bone}" HeightRequest="13" WidthRequest="160" />
                            <Border Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="90" />
                            <Border Style="{StaticResource BoneRound}" HeightRequest="18" WidthRequest="70" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="7">
                        <Border Style="{StaticResource Bone}" HeightRequest="10" HorizontalOptions="Fill" />
                        <Border Style="{StaticResource Bone}" HeightRequest="10" WidthRequest="200" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0" Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="110" />
                        <Border Grid.Column="1" Style="{StaticResource Bone}" HeightRequest="9" WidthRequest="50" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource BoneRound}" HeightRequest="44" HorizontalOptions="Fill" />
                        <Border Grid.Column="1" Style="{StaticResource BoneRound}" HeightRequest="44" HorizontalOptions="Fill" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </ControlTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <controls:DetailBar Grid.Row="0" HeaderTitle="Listing approvals" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,6,20,28" Spacing="16">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Admin" Style="{StaticResource Kicker}" />
                        <Label Text="Review new listings" Style="{StaticResource ScreenTitle}" FontSize="23" />
                        <Label Text="Nothing reaches the campus feed until you approve it. The seller's 24-hour auction starts at approval."
                               Style="{StaticResource ScreenSubtitle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Refresh" Style="{StaticResource GoldPillButton}" VerticalOptions="Start"
                            Command="{Binding LoadCommand}" IsEnabled="{Binding IsNotBusy}" />
                </Grid>



                <controls:Skeleton IsActive="{Binding IsLoading}">
                    <VerticalStackLayout Spacing="12">
                        <ContentView ControlTemplate="{StaticResource ApprovalCardBones}" />
                        <ContentView ControlTemplate="{StaticResource ApprovalCardBones}" />
                    </VerticalStackLayout>
                </controls:Skeleton>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Pending}" IsVisible="{Binding IsNotLoading}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PendingListingViewModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" HeightRequest="72" WidthRequest="72" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource NuNavyLight}">
                                            <Grid>
                                                <Path Style="{StaticResource IconImage}" HeightRequest="24" WidthRequest="24" Opacity="0.55"
                                                      HorizontalOptions="Center" VerticalOptions="Center" Fill="{StaticResource NuNavy}" />
                                                <Image Aspect="AspectFill" Source="{Binding CoverPhoto}" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Style="{StaticResource CardTitle}" Text="{Binding Title}"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Style="{StaticResource MetaText}" Text="{Binding SellerName, StringFormat='by {0}'}" />
                                            <Border Style="{StaticResource GoldBadge}" Padding="8,2">
                                                <Label Text="{Binding PackageDisplay}" Style="{StaticResource GoldBadgeText}" FontSize="10" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label Text="{Binding Description}" Style="{StaticResource ScreenSubtitle}" FontSize="13"
                                           MaxLines="4" LineBreakMode="TailTruncation"
                                           IsVisible="{Binding Description, Converter={StaticResource HasValue}}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Style="{StaticResource MetaText}" VerticalOptions="Center"
                                               Text="{Binding StartingBidDisplay, StringFormat='Starting bid {0}'}" />
                                        <Label Grid.Column="1" Style="{StaticResource MetaText}" VerticalOptions="Center"
                                               Text="{Binding SubmittedAt, Converter={StaticResource TimeAgo}}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Grid.Column="0" Text="Reject" Style="{StaticResource GhostButton}" HeightRequest="44"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.RejectCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Approve" Style="{StaticResource NavyButton}" HeightRequest="44"
                                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.ApproveCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" IsVisible="{Binding ShowEmptyState}">
                    <VerticalStackLayout Spacing="6" Padding="0,10">
                        <Path Style="{StaticResource IconCheck}" HeightRequest="26" WidthRequest="26" HorizontalOptions="Center"
                              Fill="{StaticResource NuGold}" />
                        <Label Text="All caught up" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                        <Label Text="No listings are waiting for approval." Style="{StaticResource ScreenSubtitle}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- In-app notifications (posted, won, paid) draw over the page -->
        <controls:NotificationHost Grid.Row="0" Grid.RowSpan="2" />
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="2" />
    </Grid>

</views:AppContentPage>
