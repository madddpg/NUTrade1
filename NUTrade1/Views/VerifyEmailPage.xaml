<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.VerifyEmailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    x:DataType="vm:VerifyEmailViewModel"
    Shell.NavBarIsVisible="False"
    Title="Confirm your email">

    <Grid>
    <ScrollView>
        <Grid Padding="26" RowDefinitions="Auto,*,Auto,*">

            <HorizontalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Start">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding UseAnotherAccountCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Path Style="{StaticResource LineChevronLeft}" HeightRequest="18" WidthRequest="18"
                      Stroke="{StaticResource InkMuted}" VerticalOptions="Center" />
                <Label Text="Sign out" FontFamily="InterRegular" FontSize="15" TextColor="{StaticResource InkMuted}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="18" VerticalOptions="Center">

                <Border HeightRequest="72" WidthRequest="72" StrokeThickness="1" Stroke="#D6DCE6" StrokeShape="RoundRectangle 999"
                        BackgroundColor="{StaticResource White}" HorizontalOptions="Center">
                    <Image Source="nutrade_mark.png" HeightRequest="46" WidthRequest="46" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Check your email" Style="{StaticResource ScreenTitle}" FontSize="26"
                           HorizontalTextAlignment="Center" />
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource ScreenSubtitle}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="We sent a 6-digit code to " />
                                <Span Text="{Binding SentTo}" FontFamily="InterSemiBold" />
                                <Span Text=". Enter it to finish setting up your account." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="14">
                        <Button Text="Enter code" Style="{StaticResource GoldButton}"
                                Command="{Binding OpenCodeModalCommand}" IsEnabled="{Binding IsNotBusy}" />

                        <controls:BusyBones IsActive="{Binding IsBusy}" Caption="Sending your code…" />

                        <!-- A send that failed leaves the sheet closed, so the reason has to show here too. -->

                        <Button Text="{Binding ResendText}" Style="{StaticResource GhostButton}"
                                Command="{Binding RequestCodeCommand}" IsEnabled="{Binding CanResend}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Sign out" Style="{StaticResource GhostButton}"
                        Command="{Binding UseAnotherAccountCommand}" />

                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Path Style="{StaticResource IconClock}" HeightRequest="13" WidthRequest="13"
                          Fill="{StaticResource InkMuted}" />
                    <Label Text="Codes expire after 10 minutes." Style="{StaticResource MetaText}" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

        <controls:OtpModal IsOpen="{Binding IsCodeModalOpen}" Code="{Binding Code}"
                           Message="{Binding Message}" VerifyText="Verify code"
                           VerifyCommand="{Binding SubmitCommand}"
                           ResendCommand="{Binding RequestCodeCommand}"
                           ResendText="{Binding ResendText}" CanResend="{Binding CanResend}"
                           CloseCommand="{Binding CloseCodeModalCommand}"
                           IsBusy="{Binding IsBusy}" />

        <controls:ToastHost />
    </Grid>

</views:AppContentPage>
