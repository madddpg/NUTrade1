<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.FeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    xmlns:core="clr-namespace:NUTrade1.Core;assembly=NUTrade1.Core"
    x:Name="Page"
    x:DataType="vm:FeedViewModel"
    Title="Home">

    <ContentPage.Resources>
        <!-- One listing card in bones: cover, category, title, highest bid, footer line. -->
        <ControlTemplate x:Key="FeedCardBones">
            <Border Style="{StaticResource Card}" Padding="6" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource Bone}" HeightRequest="124" HorizontalOptions="Fill" StrokeShape="RoundRectangle 12" />
                    <VerticalStackLayout Padding="4,11,4,5" Spacing="7">
                        <Border Style="{StaticResource Bone}" HeightRequest="8" WidthRequest="54" />
                        <Border Style="{StaticResource Bone}" HeightRequest="12" HorizontalOptions="Fill" />
                        <Border Style="{StaticResource Bone}" HeightRequest="12" WidthRequest="80" />
                        <Border Style="{StaticResource Bone}" HeightRequest="8" WidthRequest="58" Margin="0,4,0,0" />
                        <Border Style="{StaticResource Bone}" HeightRequest="15" WidthRequest="68" />
                        <Border Style="{StaticResource Bone}" HeightRequest="8" HorizontalOptions="Fill" Margin="0,3,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ControlTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <controls:TopBar Grid.Row="0" />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView
                ItemsSource="{Binding Listings}"
                RemainingItemsThreshold="4"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                Margin="20,0">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2"
                                     HorizontalItemSpacing="12" VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,6,0,6" Spacing="18">

                        <!-- Hero -->
                        <Border Style="{StaticResource HeroCard}" Padding="22,20">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8" Margin="0,0,0,6">
                                    <Path Style="{StaticResource IconSparkle}" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"
                                          Fill="{StaticResource NuGold}" />
                                    <Label Text="NU-Lipa Campus Marketplace" FontFamily="InterRegular" FontSize="14"
                                           TextColor="{StaticResource NuGold}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="Find it. Bid it." FontFamily="InterBold" FontSize="27" TextColor="{StaticResource White}" />
                                <Label Text="Make it yours." FontFamily="Lobster" FontSize="30" TextColor="{StaticResource NuGold}"
                                       Margin="0,-6,0,0" />
                                <Label Text="New regular listings join after the hourly refresh. Priority listings appear immediately"
                                       FontFamily="InterRegular" FontSize="13.5" LineHeight="1.3" TextColor="{StaticResource HeroMuted}"
                                       Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Search + filter -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource SearchBg}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" Padding="16,0" HeightRequest="46">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Path Grid.Column="0" Style="{StaticResource LineSearch}" HeightRequest="17" WidthRequest="17"
                                          Stroke="{StaticResource InkMuted}" StrokeThickness="2" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Style="{StaticResource ShellEntry}" Text="{Binding SearchText}"
                                           Placeholder="Search" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource FilterBg}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999" HeightRequest="46" WidthRequest="46">
                                <Path Style="{StaticResource LineSliders}" HeightRequest="20" WidthRequest="20"
                                      Stroke="{StaticResource InkMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <!-- Category filter chips -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,-4,0,0">
                            <HorizontalStackLayout Spacing="9">
                                <controls:SelectableChip Text="All" Value="All" Command="{Binding SelectCategoryCommand}"
                                                         IsSelected="{Binding SelectedCategory, Converter={StaticResource IsNull}}" />
                                <controls:SelectableChip Text="Uniforms" Value="Uniforms" Command="{Binding SelectCategoryCommand}"
                                                         IsSelected="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Uniforms}" />
                                <controls:SelectableChip Text="Textbooks" Value="Textbooks" Command="{Binding SelectCategoryCommand}"
                                                         IsSelected="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Textbooks}" />
                                <controls:SelectableChip Text="Supplies" Value="AcademicSupplies" Command="{Binding SelectCategoryCommand}"
                                                         IsSelected="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=AcademicSupplies}" />
                                <controls:SelectableChip Text="Other" Value="Other" Command="{Binding SelectCategoryCommand}"
                                                         IsSelected="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Other}" />
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="core:Listing">
                        <Border Style="{StaticResource Card}" Padding="6" StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenListingCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="0">

                                <!-- Cover -->
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="124"
                                        BackgroundColor="{StaticResource NuNavyLight}">
                                    <Grid>
                                        <Image Aspect="AspectFill"
                                               Source="{Binding Photos, Converter={StaticResource FirstOrDefault}}" />

                                        <Border BackgroundColor="{StaticResource NuGold}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                                Padding="7,2" Margin="7" VerticalOptions="Start" HorizontalOptions="Start"
                                                IsVisible="{Binding IsPinned}">
                                            <HorizontalStackLayout Spacing="3">
                                                <Path Style="{StaticResource IconPin}" HeightRequest="10" WidthRequest="10" VerticalOptions="Center"
                                                      Fill="{StaticResource NuNavy}" />
                                                <Label Text="Priority" FontFamily="InterBold" FontSize="10" TextColor="{StaticResource NuNavy}" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <Border BackgroundColor="{StaticResource OverlayDark}" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                                Padding="8,2" Margin="7" VerticalOptions="Start" HorizontalOptions="End">
                                            <Label FontFamily="InterMedium" FontSize="10" TextColor="{StaticResource White}"
                                                   Text="{Binding Condition, Converter={StaticResource EnumDisplay}, ConverterParameter='Good'}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Body -->
                                <VerticalStackLayout Padding="4,9,4,3" Spacing="2">
                                    <Label FontFamily="InterBold" FontSize="9.5" CharacterSpacing="0.4" TextTransform="Uppercase"
                                           TextColor="{StaticResource NuGold}"
                                           Text="{Binding Category, Converter={StaticResource EnumDisplay}, ConverterParameter='Item'}" />
                                    <Label FontFamily="InterBold" FontSize="13.5" TextColor="{StaticResource Ink}"
                                           MaxLines="2" LineBreakMode="TailTruncation" Text="{Binding Title}" />
                                    <Label Text="HIGHEST BID" FontFamily="InterMedium" FontSize="9.5" CharacterSpacing="0.4"
                                           TextColor="{StaticResource InkMuted}" Margin="0,4,0,0" />
                                    <Label FontFamily="InterBold" FontSize="16" TextColor="{StaticResource Ink}"
                                           Text="{Binding CurrentHighestBidCentavos, Converter={StaticResource Centavos}}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,5,0,0">
                                        <Label Grid.Column="0" FontFamily="InterRegular" FontSize="9.5" TextColor="{StaticResource InkMuted}"
                                               LineBreakMode="TailTruncation" VerticalOptions="Center"
                                               Text="{Binding BidCount, StringFormat='{0} bids · refreshes hourly'}" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Path Style="{StaticResource LineTimer}" HeightRequest="10" WidthRequest="10"
                                                  Stroke="{StaticResource InkMuted}" StrokeThickness="2" VerticalOptions="Center" />
                                            <Label FontFamily="InterRegular" FontSize="9.5" TextColor="{StaticResource InkMuted}"
                                                   Text="{Binding CountdownText}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,0,0,128" Spacing="8">
                        <!-- The feed loading: the header stays, the cards arrive as bones. -->
                        <controls:Skeleton IsActive="{Binding IsLoading}" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                                <ContentView Grid.Row="0" Grid.Column="0" ControlTemplate="{StaticResource FeedCardBones}" />
                                <ContentView Grid.Row="0" Grid.Column="1" ControlTemplate="{StaticResource FeedCardBones}" />
                                <ContentView Grid.Row="1" Grid.Column="0" ControlTemplate="{StaticResource FeedCardBones}" />
                                <ContentView Grid.Row="1" Grid.Column="1" ControlTemplate="{StaticResource FeedCardBones}" />
                                <ContentView Grid.Row="2" Grid.Column="0" ControlTemplate="{StaticResource FeedCardBones}" />
                                <ContentView Grid.Row="2" Grid.Column="1" ControlTemplate="{StaticResource FeedCardBones}" />
                            </Grid>
                        </controls:Skeleton>

                        <!-- The next page on its way, under the last row. -->
                        <controls:Skeleton IsActive="{Binding IsLoadingMore}" Margin="0,14,0,0">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <ContentView Grid.Column="0" ControlTemplate="{StaticResource FeedCardBones}" />
                                <ContentView Grid.Column="1" ControlTemplate="{StaticResource FeedCardBones}" />
                            </Grid>
                        </controls:Skeleton>

                        <VerticalStackLayout Spacing="8" Margin="0,26,0,0" IsVisible="{Binding ShowEmptyState}">
                            <Path Style="{StaticResource IconTag}" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center"
                                  Fill="{StaticResource InkMuted}" />
                            <Label Text="No auctions yet" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                            <Label Text="Published auctions from around campus will show up here. Be the first — tap + to post one."
                                   Style="{StaticResource ScreenSubtitle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="1" Active="Home" VerticalOptions="End" />

        <!-- In-app notifications (posted, won, paid) draw over the page -->
        <controls:NotificationHost Grid.Row="0" Grid.RowSpan="2" />
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="2" />
    </Grid>

</views:AppContentPage>
