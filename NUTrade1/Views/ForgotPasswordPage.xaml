<?xml version="1.0" encoding="utf-8" ?>
<views:AppContentPage
    x:Class="NUTrade1.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NUTrade1.Views"
    xmlns:controls="clr-namespace:NUTrade1.Controls"
    xmlns:vm="clr-namespace:NUTrade1.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Shell.NavBarIsVisible="False"
    Title="Reset your password">

    <Grid>
    <ScrollView>
        <Grid Padding="26" RowDefinitions="Auto,*,Auto,*">

            <HorizontalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Start">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Path Style="{StaticResource LineChevronLeft}" HeightRequest="18" WidthRequest="18"
                      Stroke="{StaticResource InkMuted}" VerticalOptions="Center" />
                <Label Text="Back" FontFamily="InterRegular" FontSize="15" TextColor="{StaticResource InkMuted}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="2" Spacing="18" VerticalOptions="Center">

                <Border HeightRequest="72" WidthRequest="72" StrokeThickness="1" Stroke="#D6DCE6" StrokeShape="RoundRectangle 999"
                        BackgroundColor="{StaticResource White}" HorizontalOptions="Center">
                    <Image Source="nutrade_mark.png" HeightRequest="46" WidthRequest="46" Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding StepLabel}" Style="{StaticResource Kicker}" HorizontalOptions="Center" />
                    <Label Text="{Binding Heading}" Style="{StaticResource ScreenTitle}" FontSize="26"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Subheading}" Style="{StaticResource ScreenSubtitle}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="14">

                        <!-- Step 1: email. Stays visible behind the code modal. -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding ShowEmailForm}">
                            <Border Style="{StaticResource InputShell}">
                                <Entry Style="{StaticResource ShellEntry}" Placeholder="Your email address" Text="{Binding Email}"
                                   Keyboard="Email" ReturnType="Go" ReturnCommand="{Binding SendCodeCommand}" />
                            </Border>
                            <Button Text="Send reset code" Style="{StaticResource GoldButton}"
                                    Command="{Binding SendCodeCommand}" IsEnabled="{Binding IsNotBusy}" />
                        </VerticalStackLayout>

                        <!-- Step 2 lives in the OtpModal at the bottom of this file. -->

                        <!-- Step 3: the new password -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding IsPasswordStep}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="New password" Style="{StaticResource FieldLabel}" FontSize="14" />
                                <controls:PasswordField Text="{Binding Password}" Placeholder="At least 8 characters" ReturnType="Next" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Confirm new password" Style="{StaticResource FieldLabel}" FontSize="14" />
                                <controls:PasswordField Text="{Binding ConfirmPassword}" Placeholder="Type it again"
                                                        ReturnType="Go" ReturnCommand="{Binding ResetPasswordCommand}" />
                            </VerticalStackLayout>
                            <Button Text="Reset password" Style="{StaticResource GoldButton}"
                                    Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding IsNotBusy}" />
                        </VerticalStackLayout>

                        <controls:BusyBones IsActive="{Binding IsBusy}" Caption="Working…" />

                    </VerticalStackLayout>
                </Border>

                <Button Text="Sign in" Style="{StaticResource GhostButton}" Command="{Binding SignInCommand}" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

        <!-- Step 2: the emailed code, as a modal over the email form. -->
        <controls:OtpModal IsOpen="{Binding IsCodeStep}" Code="{Binding Code}"
                           Message="{Binding Subheading}" VerifyText="Verify code"
                           VerifyCommand="{Binding VerifyCodeCommand}"
                           ResendCommand="{Binding SendCodeCommand}"
                           ResendText="{Binding ResendText}" CanResend="{Binding CanResend}"
                           CloseCommand="{Binding BackCommand}"
                           IsBusy="{Binding IsBusy}" />

        <controls:ToastHost />
    </Grid>

</views:AppContentPage>
