<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NUTrade1.Controls.SelectableChip"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border x:Name="Root" StrokeShape="RoundRectangle 22" StrokeThickness="1" Padding="16,9"
            HorizontalOptions="Start">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Label x:Name="ChipLabel" FontFamily="InterSemiBold" FontSize="13.5"
               HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
    </Border>
</ContentView>
