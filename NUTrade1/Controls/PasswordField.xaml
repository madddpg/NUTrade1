<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NUTrade1.Controls.PasswordField"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Bindings go through Source={x:Reference Self} on purpose: the ContentView keeps
         the page's ViewModel as its BindingContext, so the properties below resolve
         against the control while the page still binds Text="{Binding Password}". -->
    <Border Style="{StaticResource InputShell}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Entry x:Name="Field" Grid.Column="0" Style="{StaticResource ShellEntry}"
                   Text="{Binding Text, Source={x:Reference Self}, Mode=TwoWay}"
                   Placeholder="{Binding Placeholder, Source={x:Reference Self}}"
                   IsPassword="{Binding IsHidden, Source={x:Reference Self}}"
                   ReturnType="{Binding ReturnType, Source={x:Reference Self}}"
                   ReturnCommand="{Binding ReturnCommand, Source={x:Reference Self}}" />

            <!-- A 44pt-wide tap target, because a 16pt glyph is not one. -->
            <Grid Grid.Column="1" WidthRequest="30" HeightRequest="44" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnToggleTapped" />
                </Grid.GestureRecognizers>
                <Path x:Name="ShowGlyph" Style="{StaticResource IconEye}" HeightRequest="19" WidthRequest="19"
                      Fill="{StaticResource InkMuted}" HorizontalOptions="Center" VerticalOptions="Center"
                      InputTransparent="True" />
                <Path x:Name="HideGlyph" Style="{StaticResource IconEyeOff}" HeightRequest="19" WidthRequest="19"
                      Fill="{StaticResource InkMuted}" HorizontalOptions="Center" VerticalOptions="Center"
                      InputTransparent="True" IsVisible="False" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
