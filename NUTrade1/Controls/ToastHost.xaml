<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="NUTrade1.Controls.ToastHost"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    VerticalOptions="Start"
    IsVisible="False"
    InputTransparent="True"
    CascadeInputTransparent="False">

    <!-- InputTransparent on the host with CascadeInputTransparent="False" lets taps fall
         through everywhere except the pill itself, so a toast never blocks the screen
         underneath — the point of a toast rather than a dialog. -->
    <!-- No Shadow here on purpose. CardShadow is a semi-transparent brush, and on Android a
         shadowed Border composites its children through that alpha layer — barely visible on
         the app's white cards, but it washes white text on a saturated pill out to the point
         of being unreadable. A hairline stroke gives the lift instead. -->
    <Border x:Name="Pill" StrokeThickness="1" StrokeShape="RoundRectangle 14"
            Stroke="#22FFFFFF" Padding="15,12" Margin="14,0,14,0"
            HorizontalOptions="Center" MaximumWidthRequest="520">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnDismissRequested" />
            <!-- Flick it away, the way every mobile toast behaves. -->
            <SwipeGestureRecognizer Direction="Up" Swiped="OnDismissRequested" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Path x:Name="Glyph" Grid.Column="0" HeightRequest="19" WidthRequest="19"
                  Fill="{StaticResource White}" VerticalOptions="Start" Margin="0,1,0,0" />
            <Label x:Name="MessageLabel" Grid.Column="1" FontFamily="InterSemiBold" FontSize="14.5"
                   LineHeight="1.35" TextColor="{StaticResource White}"
                   MaxLines="3" LineBreakMode="WordWrap" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
